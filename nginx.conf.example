# Nginx Configuration Template for АНО «ЮГ-ПРАВО» (yug-pravo.ru)
# Местоположение на сервере: /etc/nginx/sites-available/yug-pravo.conf

server {
    listen 80;
    listen [::]:80;
    server_name yug-pravo.ru www.yug-pravo.ru;

    # Редирект всего HTTP на HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name yug-pravo.ru www.yug-pravo.ru;

    # SSL сертификаты (выпускаются через certbot --nginx)
    # ssl_certificate /etc/letsencrypt/live/yug-pravo.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/yug-pravo.ru/privkey.pem;

    root /var/www/yug-pravo;
    index index.html;

    # Оптимизация сжатия (Gzip)
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml+rss image/svg+xml;

    # Статические файлы сайта и кэширование
    location / {
        try_files $uri $uri/ /index.html;
        expires 1h;
        add_header Cache-Control "public, no-transform";
    }

    # Кэширование медиа-файлов, видео и шрифтов
    location ~* \.(mp4|webm|jpg|jpeg|png|webp|svg|ico|woff2|woff|ttf|pdf|docx)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        access_log off;
    }

    # Проксирование API (платежи Т-Банк, заявки граждан в Telegram) на Node.js сервер
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Защита скрытых файлов
    location ~ /\. {
        deny all;
    }
}
